{
  "name": "rivet",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "npm run build",
    "build": "tsc -p tsconfig.build.json && node -e \"require('node:fs').copyFileSync('src/agents/fake-agent.mjs','dist/agents/fake-agent.mjs')\" && vite build --config web/vite.config.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "smoke:package": "node scripts/package-smoke.mjs",
    "desktop:package": "npm run build && node scripts/stage-desktop.mjs && npm --prefix desktop run package"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^5.2.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "jszip": "3.10.1",
    "lucide-react": "^1.66.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^7.3.7",
    "vitest": "^5.0.2",
    "zustand": "^5.0.16"
  },
  "bin": {
    "rivet": "dist/cli/main.js"
  },
  "dependencies": {
    "@agentclientprotocol/claude-agent-acp": "0.96.0",
    "mammoth": "1.13.0",
    "node-pty": "^1.1.0",
    "pdf-parse": "2.4.5",
    "ws": "^8.22.1",
    "yaml": "^2.9.1"
  },
  "files": [
    "dist",
    "bin"
  ],
  "description": "Local orchestration for coding agents with isolated worktrees, conversation tools and pull request feedback.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kartikg-gk/rivet-code1.git"
  }
}

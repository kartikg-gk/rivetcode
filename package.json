{
  "name": "rivet",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "npm run build",
    "build": "tsc -p tsconfig.build.json && node -e \"require('node:fs').copyFileSync('src/agents/fake-agent.mjs','dist/agents/fake-agent.mjs')\"",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "smoke:package": "node scripts/package-smoke.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "bin": {
    "rivet": "dist/cli/main.js"
  },
  "dependencies": {
    "@agentclientprotocol/claude-agent-acp": "0.96.0",
    "node-pty": "^1.1.0",
    "yaml": "^2.9.1"
  },
  "files": [
    "dist",
    "bin"
  ],
  "description": "Local orchestration for coding agents with isolated worktrees, conversation tools and pull request feedback.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kartikg-gk/rivet-code1.git"
  }
}
